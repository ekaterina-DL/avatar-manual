@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo.
echo ============================================================
echo   ЛОКАЛЬНЫЙ ПРОСМОТР САЙТА-МАНУАЛА (со всеми этапами)
echo ============================================================
echo.
echo   Открой в браузере:
echo.
echo       http://127.0.0.1:8000/avatar-manual/
echo.
echo   Вкладка "3 этап" — вверху страницы.
echo.
echo   * Это окно НЕ закрывай, пока смотришь сайт.
echo   * Если страница пустая или "не удаётся подключиться" —
echo     подожди 5 секунд и нажми F5 (обновить).
echo   * Правки в файлах manual-3-etap подхватываются сразу
echo     после сохранения — просто обнови вкладку.
echo   * Чтобы остановить — закрой это окно.
echo.
echo ------------------------------------------------------------
echo.

start "" "http://127.0.0.1:8000/avatar-manual/"

python -m mkdocs serve -f site/mkdocs.yml

echo.
echo ------------------------------------------------------------
echo   Сервер остановлен. Окно можно закрыть.
echo.
echo   Если выше видно "python" не является внутренней командой —
echo   значит не найден Python. Напиши об этом Claude Code.
echo ------------------------------------------------------------
pause
